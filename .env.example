# Used by docker-compose.yml to provision the MariaDB container.
# These values must match DB_NAME / DB_USER / DB_PASSWORD in atg_backend/.env.
# Generate strong passwords with: openssl rand -hex 24
DB_ROOT_PASSWORD=change_me_root_password
DB_NAME=atg_apply1
DB_USER=atg_app
DB_PASSWORD=change_me_db_password
