# ---- Dependencies ----
node_modules/

# ---- Environment variables ----
.env
.env.local
.env.*.local
.env.atg
!.env.example

# ---- Logs ----
# Winston's rotated log files. Anchored to the directory it actually writes to
# (config/atg_logger.js) — a bare `logs/` also matched the source directory
# atg_backend/modules/logs/, so that whole module was silently untracked.
/atg_backend/logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ---- Build output ----
dist/
dist-ssr/
build/

# ---- Prisma ----
/generated/prisma

# ---- Uploaded / runtime-generated files ----
atg_backend/uploads/*
!atg_backend/uploads/.gitkeep

# ---- Editor / IDE ----
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---- OS ----
.DS_Store
Thumbs.db

*.local
