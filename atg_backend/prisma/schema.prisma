datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                   Int       @id @default(autoincrement())
  email                String    @unique
  name                 String
  // Optional: users who only ever sign in through Google or Microsoft have no
  // password. Previously required, which forced the social-login path to
  // fabricate and hash a random password for every SSO user.
  password             String?
  phone                String?
  country              String?
  city                 String?
  role                 String    @default("candidate") // admin, operator, candidate, visitor, company
  pkg                  String    @default("Trial") // Trial, Premium, Professional
  appsUsed             Int       @default(0)
  appsTotal            Int       @default(2)
  capacity             Int       @default(10) // operators only: max concurrent applications they can staff
  createdAt            DateTime  @default(now())
  d_status             String    @default("active")
  isLegendary          Boolean   @default(false)
  profilePhoto         String?
  bio                  String?   @db.Text
  department           String?
  resetPasswordToken   String?
  resetPasswordExpires DateTime?

  emailVerificationToken   String?
  emailVerificationExpires DateTime?

  // Federated identity. provider is "google" | "microsoft" (null for local
  // password accounts); externalId is the IdP's stable subject — Google's `sub`
  // or Entra's `oid` — which survives the user changing their email address.
  // emailVerified records whether the address was verified by the IdP; accounts
  // are only auto-linked by email when it was.
  provider      String?
  externalId    String?
  emailVerified Boolean @default(false)

  // Relations
  applications CandidateApplication[] @relation("CandidateApps")
  staffedApps  CandidateApplication[] @relation("StaffedApps")

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])

  requests      ChangeRequest[] @relation("CreatedRequests")
  profileValues ProfileValue[]
  skills        UserSkill[]
  userJobRoles  UserJobRole[]

  profile                UserProfile?
  phones                 UserPhone[]
  addresses              UserAddress[]
  academicQualifications UserAcademicQualification[]
  languages              UserLanguage[]
  itSkills               UserItSkill[]
  documents              UserDocument[]
  otherQualifications    UserOtherQualification[]
  experiences            UserExperience[]
  references             UserReference[]
  comments               ApplicationComment[]
  discoveryProfile       AnonymousDiscoveryProfile?

  @@unique([provider, externalId])
  @@index([companyId])
  @@index([role, d_status])
  @@index([d_status])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  email       String   @unique
  website     String?
  description String?
  status      String   @default("pending") // pending, approved, rejected
  d_status    String   @default("active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users User[]
  jobs  Job[]

  @@index([d_status])
}

model Job {
  id         Int       @id @default(autoincrement())
  company    String // backward compatibility text field
  companyId  Int?
  companyRel Company?  @relation(fields: [companyId], references: [id])
  title      String
  location   String?
  source     String?
  deadline   DateTime?
  status     String    @default("approved") // pending_payment, pending, approved, rejected
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  d_status   String    @default("active")

  jobUrl       String? @db.Text
  fitReason    String? @db.Text
  experience   String?
  locationType String?
  description  String? @db.Text

  // Set only on imported postings (see modules/jobs/jobImport.service.js).
  // externalSource + externalId is the dedupe key across re-runs; jobUrl is not
  // stable enough to serve as one.
  externalSource String?
  externalId     String?
  isRemote       Boolean   @default(false)
  datePosted     DateTime?
  salaryMin      Decimal?  @db.Decimal(12, 2)
  salaryMax      Decimal?  @db.Decimal(12, 2)
  salaryCurrency String?
  salaryInterval String?

  jobRoleId Int?
  jobRole   JobRole? @relation(fields: [jobRoleId], references: [id])

  applications CandidateApplication[]
  payments     Payment[]              @relation("JobPayments")
  formColumns  JobFormColumn[]
  skills       JobSkill[]

  @@index([companyId])
  @@index([jobRoleId])
  @@index([d_status, createdAt])
  @@index([externalSource, externalId])
}

model JobRole {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  status    String   @default("active") // pending, active, rejected
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  jobRoleSkills JobRoleSkill[]
  jobs          Job[]
  userJobRoles  UserJobRole[]

  @@index([d_status])
  @@index([status])
}

model CandidateApplication {
  id                      Int       @id @default(autoincrement())
  userId                  Int
  jobId                   Int?
  scholarshipId           Int?
  staffId                 Int?
  fitScore                Float?
  successRate             Float?
  reason                  String?
  status                  String    @default("pending_approval")
  candidateApproval       Boolean   @default(false)
  qcApproval              Boolean   @default(false)
  proof                   String?
  proofRef                String?
  internalNotes           String?
  appliedAt               DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  candidateComment        String?   @db.Text
  operatorDocNotes        String?   @db.Text
  candidateFeedback       String?   @db.Text
  candidateFeedbackRating Int?
  jobLinkRequest          String?   @db.Text // candidate-submitted external job URL for link-review flow
  operatorFitNote         String?   @db.Text // operator's written fit assessment for link requests
  d_status                String    @default("active")

  user        User                 @relation("CandidateApps", fields: [userId], references: [id])
  job         Job?                 @relation(fields: [jobId], references: [id])
  scholarship Scholarship?         @relation(fields: [scholarshipId], references: [id])
  staff       User?                @relation("StaffedApps", fields: [staffId], references: [id])
  formValues  JobFormValue[]
  comments    ApplicationComment[]

  @@index([userId, d_status])
  @@index([jobId])
  @@index([scholarshipId])
  @@index([staffId])
  @@index([status])
}

model Payment {
  id              Int      @id @default(autoincrement())
  userId          Int
  pkg             String?  @default("Trial")
  amount          Float
  paid            Boolean  @default(false)
  currency        String   @default("USD")
  method          String?
  status          String   @default("pending")
  ref             String?
  slipUrl         String?
  operatorComment String?
  appsCount       Int      @default(0)
  details         String?  @db.Text
  createdAt       DateTime @default(now())
  d_status        String   @default("active")

  jobId Int?
  job   Job? @relation("JobPayments", fields: [jobId], references: [id])

  @@index([userId, d_status])
  @@index([jobId])
  @@index([status])
}

model PaymentOption {
  id          Int      @id @default(autoincrement())
  name        String
  price       Float
  currency    String   @default("USD")
  appsCount   Int      @default(0)
  features    String?  @db.Text
  description String?  @db.Text
  isPopular   Boolean  @default(false)
  status      String   @default("active") // active, inactive
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String
  title     String
  body      String
  unread    Boolean  @default(true)
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  @@index([userId, unread])
  @@index([userId, createdAt])
}

model Scholarship {
  id           Int                    @id @default(autoincrement())
  title        String
  provider     String
  amount       Float?
  deadline     DateTime?
  description  String?
  createdAt    DateTime               @default(now())
  d_status     String                 @default("active")
  applications CandidateApplication[]

  @@index([d_status])
}

model LogEntry {
  id        Int      @id @default(autoincrement())
  category  String // system, activity, security
  level     String // e.g. error, warn, info, security, activity
  message   String   @db.Text
  meta      Json?
  userId    Int?
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  @@index([category, createdAt])
  @@index([userId])
}

model ChangeRequest {
  id          Int      @id @default(autoincrement())
  type        String // edit_user, delete_user
  targetId    Int // target User ID
  reason      String
  details     String? // stringified JSON payload of changes
  status      String   @default("pending") // pending, approved, rejected
  createdAt   DateTime @default(now())
  createdById Int
  d_status    String   @default("active")

  createdBy User @relation("CreatedRequests", fields: [createdById], references: [id])

  @@index([createdById])
  @@index([targetId])
  @@index([status])
}

// An operator's private working note about a candidate's profile.
//
// Deliberately a separate table from ProfileValue rather than a column on it.
// Candidate facts and staff opinion must not share a row: an operator must
// never be able to overwrite what the candidate said, and a note is not a fact
// about the candidate — it is a note about the work. The candidate does not see
// these; corrections they should act on go through ChangeRequest instead.
model ProfileNote {
  id        Int      @id @default(autoincrement())
  userId    Int // the candidate the note is about
  authorId  Int // the operator who wrote it
  fieldCode String? // optional: the field it concerns
  body      String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  @@index([userId, createdAt])
  @@index([authorId])
}

// One of the 20 canonical chapters of the master profile ("00" — Welcome &
// informed choice, through "19" — Final review & declaration). The code is the
// stable key: it is what the candidate builder, the operator view and any
// future migration address a chapter by, so it must not be renumbered.
model ProfileSection {
  id          Int      @id @default(autoincrement())
  code        String   @unique // "00" … "19"
  title       String
  description String?  @db.Text
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  fields ProfileColumn[]

  @@index([sortOrder])
}

// The schema for a single profile question.
//
// Kept as `ProfileColumn` rather than renamed to `ProfileField`: the brief
// permits keeping the database name, and renaming a table that already holds
// administrator-defined fields and their values buys nothing the added columns
// do not. Everything below `name` is new metadata that lets this table drive
// the candidate UI, the operator view and the privacy rules, instead of being a
// second, disconnected field system alongside the hard-coded profile form.
model ProfileColumn {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  label      String
  inputType  String // "text", "number", "file", "textarea", "select", "multiselect", "date", "boolean", "url"
  isRequired Boolean  @default(false)
  options    String?  @db.Text
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  d_status   String   @default("active")

  // Canonical field code from the ATG Apply question catalogue — "SYS-01",
  // "PREF-14", "EXP2-07". Nullable because administrator-created fields have no
  // catalogue code; unique so a catalogue code can only be seeded once.
  code      String? @unique
  sectionId Int?
  helpText  String? @db.Text

  // Privacy policy carried by the field itself, so it can be enforced rather
  // than merely displayed. CAREER | PRIVATE | SENSITIVE | RESTRICTED.
  sensitivity      String @default("CAREER")
  // Whether this value may ever be sent to an external AI service.
  // YES | LIMITED | NO. Enforced server-side when building any AI payload.
  externalAiPolicy String @default("NO")

  defaultApplicationUse String? @db.Text
  purpose               String? @db.Text

  // Set when the field belongs to a repeatable group ("education",
  // "employment", "project", "reference"), which is what lets one schema field
  // hold several entries via ProfileValue.repeatIndex.
  repeatableGroup String?
  sortOrder       Int     @default(0)
  validation      String? @db.Text
  active          Boolean @default(true)

  section ProfileSection? @relation(fields: [sectionId], references: [id])
  values  ProfileValue[]

  @@index([sectionId, sortOrder])
  @@index([repeatableGroup])
}

model ProfileValue {
  id        Int      @id @default(autoincrement())
  userId    Int
  columnId  Int
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  // Which entry of a repeatable group this value belongs to. 0 for ordinary
  // single-value fields, so existing rows keep their meaning unchanged.
  repeatIndex Int @default(0)

  // Who put the value here. Candidate facts and operator-requested corrections
  // must stay distinguishable — an operator must not be able to silently
  // overwrite what the candidate said. candidate | operator_request | import.
  source String @default("candidate")

  verified    Boolean   @default(false)
  verifiedAt  DateTime?
  // Attribution for the audit trail: who last wrote this value.
  updatedById Int?

  user   User          @relation(fields: [userId], references: [id])
  column ProfileColumn @relation(fields: [columnId], references: [id])

  @@unique([userId, columnId, repeatIndex])
  @@index([columnId])
}

model JobFormColumn {
  id         Int      @id @default(autoincrement())
  jobId      Int
  name       String
  label      String
  inputType  String // "text", "number", "file"
  isRequired Boolean  @default(false)
  options    String?  @db.Text
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  d_status   String   @default("active")

  job    Job            @relation(fields: [jobId], references: [id])
  values JobFormValue[]

  @@index([jobId])
}

model JobFormValue {
  id            Int      @id @default(autoincrement())
  applicationId Int
  columnId      Int
  value         String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  d_status      String   @default("active")

  application CandidateApplication @relation(fields: [applicationId], references: [id])
  column      JobFormColumn        @relation(fields: [columnId], references: [id])

  @@unique([applicationId, columnId])
  @@index([columnId])
}

model Skill {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  category  String? // e.g., "technical", "soft", "language"
  status    String   @default("active")
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  userSkills    UserSkill[]
  jobSkills     JobSkill[]
  jobRoleSkills JobRoleSkill[]
}

model UserSkill {
  id          Int      @id @default(autoincrement())
  userId      Int
  skillId     Int
  proficiency Int? // e.g., 1 to 5
  createdAt   DateTime @default(now())
  d_status    String   @default("active")

  user  User  @relation(fields: [userId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([userId, skillId])
  @@index([skillId])
}

model JobSkill {
  id        Int      @id @default(autoincrement())
  jobId     Int
  skillId   Int
  weight    Int? // e.g., 1 to 5
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  job   Job   @relation(fields: [jobId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([jobId, skillId])
  @@index([skillId])
}

model JobRoleSkill {
  id        Int      @id @default(autoincrement())
  jobRoleId Int
  skillId   Int
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  jobRole JobRole @relation(fields: [jobRoleId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([jobRoleId, skillId])
  @@index([skillId])
}

model UserJobRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  jobRoleId Int
  createdAt DateTime @default(now())
  d_status  String   @default("active")

  user    User    @relation(fields: [userId], references: [id])
  jobRole JobRole @relation(fields: [jobRoleId], references: [id])

  @@unique([userId, jobRoleId])
  @@index([jobRoleId])
}

model ApplicationComment {
  id            Int      @id @default(autoincrement())
  applicationId Int
  senderId      Int
  text          String   @db.Text
  type          String   @default("public") // "public" or "internal"
  createdAt     DateTime @default(now())
  d_status      String   @default("active")

  application CandidateApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  sender      User                 @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([applicationId])
  @@index([senderId])
}

model UserProfile {
  id                     Int       @id @default(autoincrement())
  userId                 Int       @unique
  firstName              String?
  lastName               String?
  gender                 String?
  dob                    DateTime?
  correspondenceLanguage String?
  nationalityAtBirth     String?
  currentNationality     String?
  legalResidency         String?
  maritalStatus          String?
  volunteerInterest      String?
  disability             Boolean   @default(false)
  refugeeStatus          Boolean   @default(false)
  closestCity            String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserPhone {
  id          Int      @id @default(autoincrement())
  userId      Int
  phoneType   String // e.g. "Mobile", "Home", "Work"
  phoneNumber String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAddress {
  id         Int      @id @default(autoincrement())
  userId     Int
  address    String
  address2   String?
  city       String
  postalCode String
  state      String
  country    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  d_status   String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserAcademicQualification {
  id              Int      @id @default(autoincrement())
  userId          Int
  degreeLevel     String
  diplomaObtained String
  fromDate        DateTime
  toDate          DateTime
  mainField       String
  university      String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  d_status        String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserLanguage {
  id        Int      @id @default(autoincrement())
  userId    Int
  language  String
  level     String // e.g., Native, Fluent, Basic
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserItSkill {
  id          Int      @id @default(autoincrement())
  userId      Int
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  docType   String // e.g., "passport", "certification"
  fileUrl   String
  fileName  String
  fileSize  Int? // in bytes
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserOtherQualification {
  id          Int      @id @default(autoincrement())
  userId      Int
  description String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserExperience {
  id               Int       @id @default(autoincrement())
  userId           Int
  jobTitle         String
  employer         String
  location         String?
  employmentType   String? // Full-time, Part-time, Contract, Internship, Freelance
  startDate        DateTime
  endDate          DateTime?
  isCurrent        Boolean   @default(false)
  responsibilities String?   @db.Text
  achievements     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  d_status         String    @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserReference {
  id           Int      @id @default(autoincrement())
  userId       Int
  refName      String
  relationship String // e.g., Manager, Colleague, Professor
  organization String?
  position     String?
  email        String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  d_status     String   @default("active")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AnonymousDiscoveryProfile {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique
  industry         String?
  targetRole       String?
  remotePreference String? // remote, hybrid, onsite, any
  salaryMin        Float?
  salaryMax        Float?
  skillsKeywords   String?  @db.Text // e.g. "React, Node.js, AWS"
  experienceYears  Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  d_status         String   @default("active")

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  operators AIOperator[]
  matches   AnonymousJobMatch[]
}

model AIOperator {
  id           Int       @id @default(autoincrement())
  profileId    Int
  name         String
  isActive     Boolean   @default(true)
  runFrequency String    @default("daily") // hourly, daily, weekly, manual
  lastRunAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  d_status     String    @default("active")

  profile AnonymousDiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
}

model AnonymousJobMatch {
  id          Int      @id @default(autoincrement())
  profileId   Int
  jobTitle    String
  companyName String?
  location    String?
  jobUrl      String?  @db.Text
  description String?  @db.Text
  fitScore    Float
  fitReason   String?  @db.Text
  status      String   @default("new") // new, bookmarked, applied, ignored
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  profile AnonymousDiscoveryProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId])
  @@index([profileId, createdAt])
}

// ─── Content management ──────────────────────────────────────────────────────
// Everything below exists so an admin can change what the app says without a
// code deploy. Values are stored and rendered as plain text or Markdown, never
// raw HTML: the public site renders them without dangerouslySetInnerHTML, so a
// compromised admin account cannot turn a content field into stored XSS.

// Key/value configuration: branding, contact details, social links, and the
// numeric defaults that were previously constants or environment variables.
model SiteSetting {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  valueType   String   @default("text") // text, longtext, number, boolean, url, email, color
  group       String   @default("general") // general, branding, contact, social, limits
  label       String
  description String?  @db.Text
  // Only rows flagged public are served on the unauthenticated endpoint the
  // marketing site reads. Anything operational stays admin-only.
  isPublic    Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")

  @@index([group, sortOrder])
}

// Copy for the public marketing pages, addressed by page + key so a page can
// gain a field without a migration.
model ContentBlock {
  id        Int      @id @default(autoincrement())
  page      String // landing, pricing, how-it-works, privacy, terms, contact
  key       String // hero.title, hero.subtitle, section.1.body, …
  value     String   @db.Text
  valueType String   @default("text") // text, longtext, markdown, url, image
  label     String
  helpText  String?  @db.Text
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  d_status  String   @default("active")

  @@unique([page, key])
  @@index([page, sortOrder])
}

// Subject/body for the transactional mail the services send. Bodies are plain
// text with {{placeholder}} substitution — see modules/notifications/email.service.js.
model EmailTemplate {
  id          Int      @id @default(autoincrement())
  key         String   @unique // welcome, password_reset, application_status, notification, contact
  name        String
  subject     String
  body        String   @db.Text
  description String?  @db.Text
  // JSON array of the placeholders this template may use. The editor shows them
  // and the service refuses to substitute anything outside the list.
  variables   String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  d_status    String   @default("active")
}
