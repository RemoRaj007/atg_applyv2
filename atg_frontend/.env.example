# Base URL for the ATG Backend APIs
VITE_API_URL="http://localhost:5000/api"

# Feature toggles
VITE_APIFY_INTEGRATION_ACTIVE=true

# Social sign-in. Each button only renders when its client id is set here, so
# leaving one blank simply hides that provider.
VITE_GOOGLE_CLIENT_ID=

# Microsoft (Entra ID) application (client) id, and optionally a tenant id.
# Leave the tenant blank to accept both work/school and personal accounts.
VITE_MICROSOFT_CLIENT_ID=
VITE_MICROSOFT_TENANT_ID=

# One-click "Fill Demo Admin / Fill Demo User" buttons on the login page.
# Leave unset in production. Only for a reviewer build whose database holds no
# real candidates — the demo admin can read every profile and document.
VITE_ENABLE_DEMO_LOGIN=
