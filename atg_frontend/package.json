{
  "name": "atg_frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.atg.config.ts",
    "build": "tsc -p tsconfig.app.atg.json && vite build --config vite.atg.config.ts && node -e \"require('fs').copyFileSync('dist/atg_index.html','dist/index.html')\"",
    "lint": "oxlint src && npm run check:locales",
    "check:locales": "node scripts/check-locales.mjs",
    "preview": "vite preview --config vite.atg.config.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.17.3",
    "@react-pdf/renderer": "^4.5.1",
    "autoprefixer": "^10.5.2",
    "axios": "^1.18.1",
    "file-saver": "^2.0.5",
    "html2pdf.js": "^0.14.0",
    "i18next": "^26.3.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "^1.23.0",
    "postcss": "^8.5.16",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.11",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.9.2",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
